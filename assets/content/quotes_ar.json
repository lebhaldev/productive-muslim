 "quotes": [
  {
   "id": "ar001",
   "arabic": "دع الأيام تفعل ما تشاء\nوطب نفسا إذا حكم القضاء",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P001",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar002",
   "arabic": "ولا تجزع لحادثة الليالي\nفما لحوادث الدنيا بقاء",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P001",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar003",
   "arabic": "ورزقك ليس ينقصه التأني\nوليس يزيد في الرزق العناء",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P001",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar004",
   "arabic": "ولا حزن يدوم ولا سرور\nولا بؤس عليك ولا رخاء",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P001",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar005",
   "arabic": "يخاطبني السفيه بكل قبح\nفأكره أن أكون له مجيبا\nيزيد سفاهة فأزيد حلما\nكعود زاده الإحراق طيبا",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P011",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar006",
   "arabic": "إذا حار أمرك في معنيين\nولم تدر حيث الخطا والصواب\nفخالف هواك فإن الهوى\nيقود النفوس إلى ما يعاب",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P016",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar007",
   "arabic": "سافر تجد عوضا عمن تفارقه\nوانصب فإن لذيذ العيش في النصب",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P018",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar008",
   "arabic": "إني رأيت وقوف الماء يفسده\nإن ساح طاب وإن لم يجر لم يطب",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P018",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar009",
   "arabic": "لما عفوت ولم أحقد على أحد\nأرحت نفسي من هم العداوات",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P021",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar010",
   "arabic": "ولرب نازلة يضيق لها الفتى\nذرعا ، وعند الله منها المخرج",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P029",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar011",
   "arabic": "والصمت عن جاهل أو أحمق شرف\nوفيه أيضا لصون العرض إصلاح",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P031",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar012",
   "arabic": "ولا تخطر هموم غد ببالي\nفإن غدا له رزق جديد",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P042",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar013",
   "arabic": "الدهر يومان ذا أمن وذا خطر\nوالعيش عيشان ذا صفو وذا كدر",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P048",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar014",
   "arabic": "وجدت سكوتي متجرا فلزمته\nإذا لم أجد ربحا فلست بخاسر",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P049",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar015",
   "arabic": "فناظر من تناظر في سكون\nحليما لا تلح ولا تكابر",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P052",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar016",
   "arabic": "تبغي النجاة ولم تسلك طريقتها\nإن السفينة لا تجري على اليبس",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P057",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar017",
   "arabic": "شكوت إلى وكيع سوء حفظي\nفأرشدني إلى ترك المعاصي\nوأخبرني بأن العلم نور\nونور الله لا يهدى لعاصي",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P061",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar018",
   "arabic": "المرء إن كان عاقلا ورعا\nأشغله عن عيوب غيره ورعه",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P064",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar019",
   "arabic": "تعصي الإله وأنت تظهر حبه\nهذا محال في القياس بديع\nلو كان حبك صادقا لأطعته\nإن المحب لمن يحب مطيع",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P067",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar020",
   "arabic": "فاقنع ولا تطمع فلا\nشيء يشين سوى الطمع",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P069",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar021",
   "arabic": "فما كل من تهواه يهواك قلبه\nولا كل من صافيته لك قد صفا",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P070",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar022",
   "arabic": "إذا لم يكن صفو الوداد طبيعة\nفلا خير في ود يجيء تكلفا",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P070",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar023",
   "arabic": "والجد يدني كل أمر شاسع\nوالجد يفتح كل باب مغلق",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P075",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar024",
   "arabic": "توكلت في رزقي على الله خالقي\nوأيقنت أن الله لا شك رازقي",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P078",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar025",
   "arabic": "ما حك جلدك مثل ظفرك\nفتول أنت جميع أمرك",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P082",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar026",
   "arabic": "رأيت القناعة رأس الغنى\nفصرت بأذيالها ممتسك",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P083",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar027",
   "arabic": "إن الفقيه هو الفقيه بفعله\nليس الفقيه بنطقه ومقاله",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P085",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar028",
   "arabic": "صن النفس واحملها على مايزينها\nتعش سالما والقول فيك جميل",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P086",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar029",
   "arabic": "ولا خير في ود امرئ متلون\nإذا الريح مالت ، مال حيث تميل",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P086",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar030",
   "arabic": "وما أكثر الإخوان حين تعدهم\nولكنهم في النائبات قليل",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P086",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar031",
   "arabic": "وإذا ما ازددت علما\nزادني علما بجهلي",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P087",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar032",
   "arabic": "تعلم فليس المرء يولد عالما\nوليس أخو علم كمن هو جاهل",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P088",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar033",
   "arabic": "بقدر الكد تكتسب المعالي\nومن طلب العلا سهر الليالي\nومن رام العلا من غير كد\nأضاع العمر في طلب المحال",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P090",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar034",
   "arabic": "رأيت العلم صاحبه كريم\nولو ولدته آباء لئام",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P094",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar035",
   "arabic": "نعيب زماننا والعيب فينا\nوما لزماننا عيب سوانا",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P106",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar036",
   "arabic": "واختر لنفسك حظها\nواصبر فإن الصبر جنه",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P114",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar037",
   "arabic": "إذا هبت رياحك فاغتنمها\nفعقبى كل خافقة سكون\nولا تغفل عن الإحسان فيها\nفلا تدري السكون متى يكون",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P117",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar038",
   "arabic": "إنما العلم عميق بحره\nفخذوا من كل شيء أحسنه",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P118",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar039",
   "arabic": "وعين الرضا عن كل عيب كليلة\nولكن عين السخط تبدي المساويا",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P122",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar040",
   "arabic": "فمن عرف الدهر الخؤون وصرفه\nتصبر للبلوى ولم يظهر الشكوى",
   "author": "الإمام الشافعي (al-Imam al-Shafi'i)",
   "work": "ديوان الإمام الشافعي (Diwan al-Imam al-Shafi'i)",
   "deathAH": 204,
   "type": "verse",
   "locator": "PageV01P123",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0225AH/master/data/0204Shafici/0204Shafici.Diwan/0204Shafici.Diwan.JK007599-ara1",
   "status": "cited-traditional-attribution"
  },
  {
   "id": "ar041",
   "arabic": "على قدر أهل العزم تأتي العزائم\nوتأتي على قدر الكرام المكارم",
   "author": "المتنبي (al-Mutanabbi)",
   "work": "ديوان المتنبي (Diwan al-Mutanabbi)",
   "deathAH": 354,
   "type": "verse",
   "locator": "PageV01P131",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0375AH/master/data/0354Mutanabbi/0354Mutanabbi.Diwan/0354Mutanabbi.Diwan.JK007610-ara1.completed",
   "status": "cited"
  },
  {
   "id": "ar042",
   "arabic": "ما كل ما يتمنى المرء يدركه\nتجري الرياح بما لا تشتهي السفن",
   "author": "المتنبي (al-Mutanabbi)",
   "work": "ديوان المتنبي (Diwan al-Mutanabbi)",
   "deathAH": 354,
   "type": "verse",
   "locator": "PageV01P134",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0375AH/master/data/0354Mutanabbi/0354Mutanabbi.Diwan/0354Mutanabbi.Diwan.JK007610-ara1.completed",
   "status": "cited"
  },
  {
   "id": "ar043",
   "arabic": "من علامة كمال العقل علو الهمة !",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P002",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar044",
   "arabic": "ليس في التكليف أصعب من الصبر على القضاء، ولا فيه أفضل من الرضى به.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P028",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar045",
   "arabic": "ليس في الوجود شيء أشرف من العلم، كيف لا وهو الدليل.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P030",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar046",
   "arabic": "ليس في الوجود شيء أصعب من الصبر إما على المحبوب أو على المكروهات.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P050",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar047",
   "arabic": "فما فات ما فات إلا بالكسل. ولا نال من نال إلا بالجد والعزم.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P052",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar048",
   "arabic": "ولو أمكنك عبور كل أحد من العلماء والزهاد فافعل، فإنهم كانوا رجالا وأنت رجل.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P052",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar049",
   "arabic": "ينبغي لطالب العلم أن يكون جل همته مصروفا إلى الحفظ والإعادة.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P067",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar050",
   "arabic": "مما أفادتني تجارب الزمان أنه لا ينبغي لأحد أن يظاهر بالعداوة أحدا ما استطاع، فإنه ربما يحتاج إليه مهما كانت منزلته.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P071",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar051",
   "arabic": "ينبغي أن يكون شغل العاقل النظر في العواقب والتحرز مما يمكن أن يكون.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P086",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar052",
   "arabic": "أما العالم فعلمه مؤنسه، وكتبه محدثه، والنظر في سير السلف مقومه، والتفكر في حوادث الزمان السابق فرجته.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P087",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar053",
   "arabic": "هذا العمر موسم.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P098",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar054",
   "arabic": "كلما نظرت في تواصل النعم علي تحيرت في شكرها، وأعلم أن الشكر من النعم فكيف أشكر، لكني معترف بالتقصير، وأرجو أن يكون اعترافي قائما ببعض الحقوق.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
   "deathAH": 597,
   "type": "prose",
   "locator": "PageV01P139",
   "sourceUrl": "https://raw.githubusercontent.com/OpenITI/0600AH/master/data/0597IbnJawzi/0597IbnJawzi.SaydKhatir/0597IbnJawzi.SaydKhatir.JK010547-ara1",
   "status": "cited"
  },
  {
   "id": "ar055",
   "arabic": "ما يتناهى في طلب العلم إلا عاشق العلم.",
   "author": "ابن الجوزي (Ibn al-Jawzi)",
   "work": "صيد الخاطر (Sayd al-Khatir)",
